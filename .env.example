# ---------------------------------------------------------------------------
# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (Supabase → Settings → API)
# ---------------------------------------------------------------------------

# URL ของโปรเจกต์ Supabase
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# anon / public key — ปลอดภัยที่จะอยู่ใน frontend
# เพราะสิทธิ์จริงถูกบังคับด้วย Row Level Security ที่ฐานข้อมูล
VITE_SUPABASE_ANON_KEY=<วาง anon public key ที่นี่>

# ---------------------------------------------------------------------------
# ใช้เฉพาะตอนรันสคริปต์ย้ายข้อมูล (npm run migrate) เท่านั้น
# service_role key ข้าม RLS ได้ทั้งหมด → ห้าม commit ห้ามใส่ใน Vercel
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=<วาง service_role key ที่นี่>
